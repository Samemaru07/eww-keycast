(defvar keycast-text "")

(defwidget keycast-widget []
    (box :class "keycast-bg"
         :orientation "h"
         :halign "center"
         :valign "center"
         :space-evenly false
         (label :class "keycast-label"
                :limit-width 0
                :text keycast-text
         )
    )
)

(defwindow keycast
    :stacking "overlay"
    :focusable false
    :geometry (geometry :anchor "bottom right"
                        :x "30px"
                        :y "30px"
                        :width "500px"
                        :height "60px"
    )
    (keycast-widget)
)
