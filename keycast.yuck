(defvar keycast-text "")

(defwidget keycast-widget []
    (box :class "keycast-bg ${caps-lock ? "keycast-caps" : ""}"
         :orientation "h"
         :halign "center"
         :valign "center"
         :space-evenly false
         (label :class "keycast-label"
                :limit-width 0
                :text keycast-text
         )
    )
)

(defwindow keycast
    :stacking "overlay"
    :focusable false
    :transparent true
    :geometry (geometry :anchor "bottom right"
                        :x "30px"
                        :y "70px"
                        :width "500px"
                        :height "60px"
    )
    (keycast-widget)
)

(defvar caps-lock false)
